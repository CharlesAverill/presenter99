2000 DATA "END_SLIDESHOW"
2001 REM  === SLIDESHOW ENGINE ===

2010 REM  = READ TITLE INFO =
2020 READ TOK$

2030 IF TOK$<>"TITLE" THEN 2040 ELSE 2060
2040 ERR$="EXPECTED TOKEN 'TITLE' BUT GOT '"&TOK$&"'"
2050 GOTO 4000
2060 READ TITLE$,SUBTITLE$,FG,BG
2070 REM  = DISPAY TITLE SCREEN = 
2080 GOSUB 4170
2085 GOSUB 4250
2086 REM  = SPLICE TEXAS GLYPH INTO TITLE AT '@' MARKER =
2087 P=POS(TITLE$,"@",1)
2088 IF P=0 THEN 2093
2089 TITLE$=SEG$(TITLE$,1,P-1)&CHR$(143)&SEG$(TITLE$,P+1,LEN(TITLE$)-P)
2093 PRINT TAB(CENTERCOL(TITLE$));TITLE$:""
2100 PRINT TAB(CENTERCOL(SUBTITLE$));SUBTITLE$
2110 ROW=15
